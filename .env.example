# ============================================================
# 智能导学 Agent (Harness) - 环境配置模板
# ============================================================
# 使用方法：复制本文件为 .env，然后填入你的配置
#   cp .env.example .env
# ============================================================

# ---- LLM API 配置（必填）----
LLM_API_KEY=your-api-key-here

# API 基础地址（OpenAI 兼容，双通道共用）
# 豆包: https://ark.cn-beijing.volces.com/api/v3
# DeepSeek: https://api.deepseek.com/v1
# 通义千问: https://dashscope.aliyuncs.com/compatible-mode/v1
# OpenAI: https://api.openai.com/v1
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 模型名称
LLM_MODEL=qwen-plus

# ---- LLM 参数（可选）----
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4096
LLM_TIMEOUT=60

# ---- 数据库配置 ----
# PostgreSQL 连接字符串（docker compose up -d 后可用默认值）
# 不可用时自动降级为纯内存模式（重启后记忆丢失）
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/postgres

# ---- Harness 编排配置（可选）----
# Supervisor 单轮最大调度次数（防死循环）
MAX_SUPERVISOR_HOPS=6
# Supervisor 路由方式：true=LLM动态调度（灵活），false=纯规则路由（延迟最低）
SUPERVISOR_LLM_ROUTING=true
# 反思/进化/步骤计划是否后台执行（true=不阻塞回复，false=同步等待，便于调试）
REFLECTION_IN_BACKGROUND=true
# SSE 流式输出开关
STREAM_ENABLED=true
# 注入 Prompt 的历史消息条数
HISTORY_WINDOW=6

# ---- LLM 熔断器（可选，深度优化新增）----
# 连续 N 次主备双失败后熔断（熔断期直接走规则降级，不再重试注定失败的请求）
LLM_CIRCUIT_FAILURE_THRESHOLD=3
# 瞬态错误（429/5xx/超时）冷却秒数
LLM_CIRCUIT_COOLDOWN_TRANSIENT=120
# 非瞬态错误（401/403/404，如额度耗尽）冷却秒数
LLM_CIRCUIT_COOLDOWN_PERMANENT=600

# ---- SSE 看门狗（可选，深度优化新增）----
# 单个事件最大等待秒数（防后台任务挂起导致客户端永久等待）
SSE_IDLE_TIMEOUT=180

# ---- 服务配置（可选）----
# HOST=0.0.0.0
# PORT=8000
# DEBUG=true

# ---- 安全配置（可选）----
# 设置后所有 /api/v2/* 请求需携带 X-API-Key 请求头
# API_KEY=
# RATE_LIMIT_ENABLED=true
# MAX_INPUT_LENGTH=2000


# ---- 用户管理系统（v5.0）----
# JWT 密钥（留空则自动生成并持久化到 .auth_secret 文件）
AUTH_SECRET=
AUTH_TOKEN_EXPIRE_HOURS=72
# 是否强制登录（生产环境建议 true）
AUTH_REQUIRED=false
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=change-me-please
AUTH_ALLOW_REGISTRATION=true

# ---- 教学经验库（v5.0）----
EXPERIENCE_MIN_EFFECTIVENESS=0.65
EXPERIENCE_MAX_ITEMS=500
