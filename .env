# ============================================================
# 智能导学 Agent - 环境配置（DeepSeek 测试通道）
# ============================================================

# ---- LLM API 配置 ----
LLM_API_KEY=sk-a867f7ecec814dfb81d167ccb1bf151c
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4096
LLM_TIMEOUT=60

# ---- 数据库配置 ----
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/postgres

# ---- 用户管理系统（v5.0）----
# JWT 密钥（留空则自动生成并持久化到 .auth_secret 文件）
AUTH_SECRET=
# 访问令牌有效期（小时）
AUTH_TOKEN_EXPIRE_HOURS=72
# 是否强制登录（true 时匿名访问返回 401；false 为开发访客模式）
AUTH_REQUIRED=true
# 初始管理员（仅当系统无任何管理员时创建一次）
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=admin123456
# 是否开放自由注册（false 时仅管理员可创建账号）
AUTH_ALLOW_REGISTRATION=true

# ---- 教学经验库（v5.0）----
# 反思效果评分达到该阈值才沉淀为教学经验
EXPERIENCE_MIN_EFFECTIVENESS=0.65
# 经验条目上限（LRU 淘汰）
EXPERIENCE_MAX_ITEMS=500
